## Copy this file to `android/keystore.properties` and fill in your values.
## Do NOT commit the real `keystore.properties` to version control.
##
## If your keystore is at android/app/app-release-key.jks, use:
## storeFile=app/app-release-key.jks

storeFile=app/app-release-key.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=upload
keyPassword=CHANGE_ME_KEY_PASSWORD


