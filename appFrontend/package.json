{
  "name": "7aside",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:dev": "expo start --web",
    "sync:pwa-icon": "node -e \"require('fs').copyFileSync('assets/icon.png','public/icon.png')\"",
    "optimize:icons": "node scripts/optimize-pwa-icon.cjs",
    "build:web": "npm run sync:pwa-icon && expo export --platform web",
    "preview:web": "npx serve dist",
    "postinstall": "patch-package",
    "update:production": "npx eas-cli@latest update --channel production",
    "update:preview": "npx eas-cli@latest update --channel preview",
    "build:android-apk": "cd android && gradlew.bat assembleRelease",
    "build:android-aab": "cd android && gradlew.bat bundleRelease",
    "build:android-apk-unix": "cd android && ./gradlew assembleRelease",
    "eas:android-apk": "npx eas-cli@latest build --platform android --profile production",
    "eas:android-aab": "npx eas-cli@latest build --platform android --profile production"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "expo": "~53.0.27",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-image-picker": "~16.1.4",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "lucide-react-native": "^1.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-animatable": "^1.4.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@types/react": "~19.0.10",
    "patch-package": "^8.0.0",
    "sharp": "^0.33.5",
    "typescript": "~5.8.3"
  },
  "private": true
}
