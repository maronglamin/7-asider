// Datasource: PostgreSQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String           @id @default(cuid())
  email          String
  username       String?          @unique
  name           String?
  passwordHash   String?
  provider       String? // 'google' | 'apple' | 'facebook' | 'email'
  providerId     String? // external provider user id
  supadmin       Boolean          @default(false)
  adminUser      Boolean          @default(false)
  adminUserType  AdminUserType?
  adminUserStatus AdminUserStatus @default(ACTIVE)
  adminTotpSecret String?
  adminTotpEnabledAt DateTime?
  status         UserStatus       @default(ACTIVE)
  /// Easypay merchant tenant (field owner / organiser), from internal-partner provision
  easypayBusinessId String?
  easypaySlug       String?
  appLockType           AppLockType?
  appLockSecretHash     String?
  appLockFailedAttempts Int          @default(0)
  appLockLockedUntil    DateTime?
  deviceLockEnabled     Boolean       @default(false)
  lockedDeviceId        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sessions       Session[]
  fieldKycs      FieldKyc[]
  bookings       FieldBooking[]
  reservations   Booking[]
  PaymentReceipt PaymentReceipt[]
  bankAccounts   BankAccount[]
  walletAccounts WalletAccount[]
  sentContractInvitations ContractInvitation[] @relation("ContractInvitationSender")
  pushDevices      PushDevice[]
  squadMemberships SquadMember[]
  devices          UserDevice[]
  lockedDevice     UserDevice?    @relation("LockedDevice", fields: [lockedDeviceId], references: [id], onDelete: SetNull)
  monthlyDevices   UserMonthlyDevice[]
  monthlyDeviceUsers DeviceMonthlyUser[]
  fieldManagerRoles FieldManager[] @relation("FieldManagerUser")
  invitedFieldManagers FieldManager[] @relation("FieldManagerInviter")
  sentFieldManagerInvites FieldManagerInvite[] @relation("FieldManagerInviteSender")
  supportTickets SupportTicket[]
  adminRoles     AdminUserRole[]
  adminGroups    AdminUserGroupMember[]

  @@index([email])
  @@index([adminUser, adminUserType])
}

/// Devices used to sign in. Fingerprint is per app install (native) or browser profile (web/PWA).
model UserDevice {
  id            String   @id @default(cuid())
  userId        String
  fingerprint   String
  deviceName    String?
  brand         String?
  manufacturer  String?
  modelName     String?
  deviceType    String?
  osName        String?
  osVersion     String?
  imei          String?
  hardwareId    String?
  isEmulator    Boolean  @default(false)
  appVersion    String?
  lastIpAddress String?
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lockedByUsers User[]   @relation("LockedDevice")

  @@unique([userId, fingerprint])
  @@index([userId, lastSeenAt])
}

/// Distinct devices a user has signed in from in a calendar month (UTC).
model UserMonthlyDevice {
  id             String   @id @default(cuid())
  userId         String
  deviceGroupKey String
  yearMonth      String
  firstLoginAt   DateTime @default(now())
  lastLoginAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceGroupKey, yearMonth])
  @@index([userId, yearMonth])
}

/// Distinct accounts that have signed in from a physical device / browser in a calendar month (UTC).
model DeviceMonthlyUser {
  id             String   @id @default(cuid())
  deviceGroupKey String
  userId         String
  yearMonth      String
  firstLoginAt   DateTime @default(now())
  lastLoginAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deviceGroupKey, userId, yearMonth])
  @@index([deviceGroupKey, yearMonth])
}

enum PushChannel {
  EXPO
  WEB_PUSH
}

/// Registered devices for push alerts (field owners receive new-booking notifications).
model PushDevice {
  id        String      @id @default(cuid())
  userId    String
  channel   PushChannel
  /// EXPO: ExponentPushToken[...]. WEB_PUSH: JSON.stringify(PushSubscription.toJSON()).
  token     String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, token])
  @@index([userId])
}

model ContractInvitation {
  id               String                         @id @default(cuid())
  recipientEmail   String
  recipientName    String?
  ccEmails         Json?
  subject          String
  templateType     ContractInvitationTemplateType @default(DEFAULT)
  messageText      String
  messageHtml      String
  proposalFilename String
  resendEmailId    String?
  sentByUserId     String
  sentAt           DateTime                       @default(now())
  createdAt        DateTime                       @default(now())

  sentBy User @relation("ContractInvitationSender", fields: [sentByUserId], references: [id])

  @@index([recipientEmail])
  @@index([sentAt])
  @@index([sentByUserId])
}

/// Local mapping of Deskline tickets owned by this user.
model SupportTicket {
  id           String   @id @default(cuid())
  userId       String
  ticketingId  String   @unique
  ticketingRef String
  topic        String
  summary      String
  message      String   @db.Text
  kind         String   @default("question")
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

enum UserStatus {
  ACTIVE
  BLOCKED
  TERMINATED
}

enum AdminUserType {
  OWNER
  OPERATOR
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

model AdminRole {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  users       AdminUserRole[]
  groups      AdminUserGroup[]
  permissions AdminRolePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("admin_roles")
}

model AdminPermission {
  id          String               @id @default(cuid())
  moduleKey   String
  actionKey   String
  name        String
  description String?
  roles       AdminRolePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([moduleKey, actionKey])
  @@map("admin_permissions")
}

model AdminUserRole {
  userId     String
  roleId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime  @default(now())

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model AdminRolePermission {
  roleId       String
  permissionId String
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime        @default(now())

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUserGroup {
  id          String                 @id @default(cuid())
  name        String                 @unique
  description String?
  roleId      String
  role        AdminRole              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  members     AdminUserGroupMember[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@map("admin_user_groups")
}

model AdminUserGroupMember {
  userId     String
  groupId    String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      AdminUserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedAt DateTime       @default(now())

  @@id([userId, groupId])
  @@map("admin_user_group_members")
}

enum AppLockType {
  PIN
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

enum ContractInvitationTemplateType {
  DEFAULT
  CUSTOM
}

enum FieldKycStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model FieldKyc {
  id               String          @id @default(cuid())
  userId           String
  name             String
  city             String?
  address          String?
  phone            String?
  surfaceType      String?
  size             String?
  pricePerHour     Decimal?        @db.Decimal(10, 2)
  hasLights        Boolean         @default(false)
  description      String?
  images           FieldKycImage[]
  status           FieldKycStatus  @default(PENDING)
  rejectionReason  String?
  suspensionReason String?
  updatedBy        String? // last updater username or identifier, no FK
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  bookings     FieldBooking[]
  reservations Booking[]
  bookingUnits BookingUnit[]
  managers     FieldManager[]
  managerInvites FieldManagerInvite[]
}

/// Extra people invited to operate a field. The owner remains FieldKyc.userId.
model FieldManager {
  id              String   @id @default(cuid())
  fieldId         String
  userId          String
  invitedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  field     FieldKyc @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  user      User     @relation("FieldManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("FieldManagerInviter", fields: [invitedByUserId], references: [id])

  @@unique([fieldId, userId])
  @@index([userId])
}

/// Email invite to become a FieldManager. Token is hashed; raw token is only emailed.
model FieldManagerInvite {
  id              String    @id @default(cuid())
  fieldId         String
  email           String
  tokenHash       String    @unique
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  field     FieldKyc @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  invitedBy User     @relation("FieldManagerInviteSender", fields: [invitedByUserId], references: [id])

  @@index([fieldId, email])
  @@index([email])
}

model FieldKycImage {
  id         String   @id @default(cuid())
  fieldKycId String
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  fieldKyc FieldKyc @relation(fields: [fieldKycId], references: [id])
}

// ============================
// Scalable booking system (v2)
// ============================

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  PENDING_REFUND
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BookingType {
  HOURLY
  FULL_DAY
  MULTI_DAY
  CUSTOM
}

model Booking {
  id            String        @id @default(cuid())
  userId        String
  fieldId       String
  type          BookingType
  startAt       DateTime // UTC start
  endAt         DateTime // UTC end (exclusive)
  timezone      String?
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("GMD")
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  note          String?
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  field          FieldKyc         @relation(fields: [fieldId], references: [id])
  units          BookingUnit[]
  PaymentReceipt PaymentReceipt[]
  squads         BookingSquad[]
  challenges     SquadChallenge[]

  @@index([userId, createdAt])
  @@index([fieldId, startAt, endAt])
}

// Each reserved hour is represented as a unit for conflict checks and analytics.
// Full-day and multi-day bookings expand into 24 hourly units per day.
model BookingUnit {
  id        String   @id @default(cuid())
  bookingId String
  fieldId   String
  date      DateTime // midnight UTC for the day this hour belongs to
  hourStart Int // 0..23 (hour bucket)
  createdAt DateTime @default(now())

  booking Booking  @relation(fields: [bookingId], references: [id])
  field   FieldKyc @relation(fields: [fieldId], references: [id])

  @@unique([fieldId, date, hourStart])
  @@index([bookingId])
  @@index([fieldId, date])
}

model FieldBooking {
  id         String   @id @default(cuid())
  fieldKycId String
  userId     String
  date       DateTime // Date-only semantics; store as UTC midnight for the day
  startHour  Int // 0-23 inclusive
  endHour    Int // 1-24 inclusive, strictly > startHour
  createdAt  DateTime @default(now())

  fieldKyc FieldKyc @relation(fields: [fieldKycId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([fieldKycId, date])
}

// Store user-uploaded payment receipts for bookings.
model PaymentReceipt {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  imageUrl  String
  note      String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([bookingId, createdAt])
  @@index([userId, createdAt])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankName      String
  accountName   String
  accountNumber String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@unique([userId, accountNumber])
}

model WalletAccount {
  id           String   @id @default(cuid())
  userId       String
  company      String
  walletNumber String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@unique([userId, walletNumber])
}

enum SquadRole {
  CAPTAIN
  MEMBER
}

enum BookingSide {
  HOME
  AWAY
}

enum SquadChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Squad {
  id         String   @id @default(cuid())
  name       String
  emoji      String   @default("⚽")
  color      String   @default("#16a34a")
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members          SquadMember[]
  bookings         BookingSquad[]
  challengesFrom   SquadChallenge[] @relation("ChallengeFrom")
  challengesTo     SquadChallenge[] @relation("ChallengeTo")
}

model SquadMember {
  id       String    @id @default(cuid())
  squadId  String
  userId   String
  role     SquadRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
}

model BookingSquad {
  id        String      @id @default(cuid())
  bookingId String
  squadId   String
  side      BookingSide @default(HOME)
  createdAt DateTime    @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  squad   Squad   @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([bookingId, squadId])
  @@unique([bookingId, side])
  @@index([squadId])
}

model SquadChallenge {
  id          String               @id @default(cuid())
  bookingId   String
  fromSquadId String
  toSquadId   String?
  token       String               @unique
  status      SquadChallengeStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime             @default(now())
  acceptedAt  DateTime?

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromSquad Squad   @relation("ChallengeFrom", fields: [fromSquadId], references: [id], onDelete: Cascade)
  toSquad   Squad?  @relation("ChallengeTo", fields: [toSquadId], references: [id], onDelete: SetNull)

  @@index([bookingId, status])
  @@index([fromSquadId])
  @@index([toSquadId])
}
