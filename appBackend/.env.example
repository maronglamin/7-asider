# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sevenaside

# JWT — required in production (generate: openssl rand -base64 48)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated frontend origins allowed to call the API
CORS_ORIGINS=https://7a-side.phantommetrics.gm

# Google OAuth — comma-separated allowed ID token audiences (Web client ID)
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Apple Sign-In — comma-separated bundle/service IDs (optional)
# APPLE_CLIENT_IDS=com.sevenaside.app

# Easypay partner integration (optional)
# EASYPAY_API_BASE_URL=
# INTERNAL_PARTNER_API_SECRET=
# INTERNAL_PARTNER_WEBHOOK_SECRET=
# INTERNAL_PARTNER_WEBHOOK_URL=https://seven-aside.phantommetrics.gm/webhooks/easypay-partner
# API_BASE=https://seven-aside.phantommetrics.gm
# APP_PUBLIC_URL=https://7a-side.phantommetrics.gm

# Email (Resend)
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=

# Web Push
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=

# Deskline (Help & Support). Create an API key on the 7-aside company
# (Admin → API keys, scopes tickets:write + tickets:read) and paste it here.
# Tickets land unassigned (NEW) for staff to pick up.
# Local: TICKETING_API_BASE_URL=http://localhost:3000/api
# TICKETING_API_BASE_URL=https://deskline.phantommetrics.gm/api
# TICKETING_API_KEY=dk_...
