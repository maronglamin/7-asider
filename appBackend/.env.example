# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sevenaside

# JWT — required in production (generate: openssl rand -base64 48)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated frontend origins allowed to call the API
CORS_ORIGINS=https://7a-side.phantommetrics.gm

# Google OAuth — comma-separated allowed ID token audiences (Web client ID)
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Apple Sign-In — comma-separated bundle/service IDs (optional)
# APPLE_CLIENT_IDS=com.sevenaside.app

# Easypay partner integration (optional)
# EASYPAY_API_BASE_URL=
# INTERNAL_PARTNER_API_SECRET=
# INTERNAL_PARTNER_WEBHOOK_SECRET=

# Email (Resend)
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=

# Web Push
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
