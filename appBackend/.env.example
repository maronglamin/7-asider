# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sevenaside

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Google OAuth — comma-separated allowed ID token audiences (use Web client ID)
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Easypay partner integration (optional)
# EASYPAY_API_BASE_URL=
# INTERNAL_PARTNER_API_SECRET=
# INTERNAL_PARTNER_WEBHOOK_SECRET=

# Email (Resend)
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=

# Web Push
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
