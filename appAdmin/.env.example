# Optional absolute API base.
# Leave empty in local dev (Vite proxies /admin + /uploads) and in production
# when Nginx on admin.7a-side.phantommetrics.gm proxies those same paths.
# VITE_API_URL=https://seven-aside.phantommetrics.gm

# Consumer app public URL used in flyer deeplinks (set for production builds)
# VITE_APP_PUBLIC_URL=https://7a-side.phantommetrics.gm
